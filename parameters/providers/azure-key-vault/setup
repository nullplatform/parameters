#!/bin/bash
set -euo pipefail

# Validates Azure Key Vault connection config.
#
# The secret prefix is hardcoded to `nullplatform-` — invariant namespace for
# all platform secrets in this vault. Only the vault name is operator-configurable.
#
# Auth comes from the Azure CLI's credential chain (managed identity, prior
# `az login`). When service-principal env vars (AZURE_CLIENT_ID / AZURE_CLIENT_SECRET
# / AZURE_TENANT_ID) are present, this script performs an explicit
# `az login --service-principal` because the az CLI — unlike the Azure SDKs —
# does not read them automatically.
#
# Exports: AZ_VAULT_NAME, AZ_SECRET_PREFIX

AZ_VAULT_NAME=$(get_config_value \
  --env AZURE_KEY_VAULT_NAME \
  --provider '.setup.vault_name')

AZ_SECRET_PREFIX="nullplatform-"

if [ -z "$AZ_VAULT_NAME" ]; then
  log error "❌ Azure Key Vault name not configured"
  log error ""
  log error "💡 Possible causes:"
  log error "   • AZURE_KEY_VAULT_NAME env var is not set"
  log error "   • .vault_name is missing in the azure-key-vault provider config"
  log error ""
  log error "🔧 How to fix:"
  log error "   • Set AZURE_KEY_VAULT_NAME=<your-vault-name>"
  log error "   • Or set .vault_name in the provider config attributes"
  exit 1
fi

# The agent runtime manages CLIs through mise, not on the base PATH. Ensure the
# Azure CLI is available, then put it on PATH so this login and the
# store/retrieve/delete steps (which inherit setup's exported env) can call `az`.
# setup always runs first, so doing it here is enough.
#
# az is a Python CLI, installed via mise's pipx backend (from PyPI). The backend
# is pinned explicitly because the version-default for `azure-cli` on older mise
# is an asdf plugin that clones from GitHub and proved unreliable. Force classic
# pipx over uv (MISE_PIPX_UVX=false): uv's resolver rejects az's pinned
# pre-release dependencies, while pipx/pip installs them fine. Requires python
# on the agent.
if ! command -v az >/dev/null 2>&1 && command -v mise >/dev/null 2>&1; then
  if ! mise which az >/dev/null 2>&1; then
    mise use --global --yes pipx@latest
    MISE_PIPX_UVX=false mise use --global --yes pipx:azure-cli
  fi
  az_bin=$(mise which az 2>/dev/null || true)
  if [ -n "$az_bin" ]; then
    az_dir=$(dirname "$az_bin")
    export PATH="$az_dir:$PATH"
  fi
fi

# Service-principal login (optional; see the header note above). Skipped when a
# session already exists (managed identity or a prior `az login`).
#
# The secret must go on argv: `az` requires --password for non-interactive
# service-principal login (it does not read it from stdin — it errors "specify
# both username and password in non-interactive mode"), so it is briefly visible
# in the process table to co-located principals. For stronger isolation prefer
# certificate-based SP auth, or run the agent in a single-tenant process. See
# docs/azure-rbac.md.
if [ -n "${AZURE_CLIENT_ID:-}" ] && [ -n "${AZURE_CLIENT_SECRET:-}" ] && [ -n "${AZURE_TENANT_ID:-}" ]; then
  if ! az account show >/dev/null 2>&1; then
    # Capture the az CLI's stderr so the real Azure error (e.g. an AADSTS code)
    # surfaces in logs — do not discard it. Its own stdout (the subscription
    # JSON) is dropped to keep setup quiet on success. The AADSTS error text does
    # not contain the client secret.
    err_file=$(mktemp)
    if az login --service-principal \
        --username "$AZURE_CLIENT_ID" \
        --password "$AZURE_CLIENT_SECRET" \
        --tenant "$AZURE_TENANT_ID" \
        --allow-no-subscriptions >/dev/null 2>"$err_file"; then
      rm -f "$err_file"
    else
      err=$(cat "$err_file")
      rm -f "$err_file"
      log error "❌ Azure service principal login failed"
      log error ""
      log error "💡 Possible causes:"
      log error "   • AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID are wrong or expired"
      log error "   • The service principal was deleted or its secret was rotated"
      log error ""
      log error "🔧 How to fix:"
      log error "   • Verify the credentials passed to the agent (AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID)"
      log error "   • Confirm the service principal has the Key Vault Secrets Officer role on the vault"
      log error "Underlying error: $err"
      exit 1
    fi
  fi
fi

export AZ_VAULT_NAME AZ_SECRET_PREFIX
